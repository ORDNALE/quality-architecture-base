// Modelo de testes ArchUnit para o perfil de CAMADAS (profiles/architecture/layered.md).
//
// USO
// - Aplicar somente se o PROJECT_PROFILE.md selecionar o perfil layered E o time aprovar a adição
//   de ArchUnit como dependência de teste (G-07). Copiar para src/test/java/<pacote>/ é alteração de
//   testes: faça em FIX autorizado ou deixe para o time.
// - Substitua os marcadores:
//     ${BASE_PACKAGE}         pacote raiz, ex.: com.empresa.erp
//     ${TEST_PACKAGE}         pacote do teste, ex.: com.empresa.erp.architecture
//     ${EE_NS}                namespace Jakarta EE: "jakarta" (Quarkus 3) ou "javax" (Quarkus 2)
//     ${RESOURCE_PKG} etc.    padrões de pacote conforme o ARCHITECTURE_CONTRACT.md (ex.: "..resource..")
// - Dependência (versão a confirmar pelo time; o modelo usa APIs de ArchUnit 1.x):
//     <dependency>
//       <groupId>com.tngtech.archunit</groupId>
//       <artifactId>archunit-junit5</artifactId>
//       <version>CONFIRMAR</version>
//       <scope>test</scope>
//     </dependency>
// - Compatibilidade de bytecode: a versão do ArchUnit precisa ler a versão de bytecode do projeto.
//   Verificado em 2026-10-08: ArchUnit 1.3.0 importou 0 classes compiladas com javac 25 (bytecode 69)
//   e importou normalmente com --release 21. Com 0 classes, as regras falham por "failed to check
//   any classes" (comportamento padrão failOnEmptyShould) — não desative isso para "passar".
// - Exceções registradas no perfil devem ser refletidas aqui (ex.: ignorar uma classe de health-check),
//   nunca simplesmente removendo a regra.
// - Dívida existente: considere envolver regras com FreezingArchRule.freeze(...) para impedir
//   violações NOVAS sem quebrar o build pelas antigas (ver documentação da versão do ArchUnit).

package ${TEST_PACKAGE};

import static com.tngtech.archunit.lang.syntax.ArchRuleDefinition.noClasses;
import static com.tngtech.archunit.library.dependencies.SlicesRuleDefinition.slices;

import com.tngtech.archunit.core.domain.JavaClass;
import com.tngtech.archunit.core.domain.JavaMethod;
import com.tngtech.archunit.core.importer.ImportOption;
import com.tngtech.archunit.junit.AnalyzeClasses;
import com.tngtech.archunit.junit.ArchTest;
import com.tngtech.archunit.lang.ArchCondition;
import com.tngtech.archunit.lang.ArchRule;
import com.tngtech.archunit.lang.ConditionEvents;
import com.tngtech.archunit.lang.SimpleConditionEvent;
import com.tngtech.archunit.lang.syntax.ArchRuleDefinition;

@AnalyzeClasses(packages = "${BASE_PACKAGE}", importOptions = ImportOption.DoNotIncludeTests.class)
class LayeredArchitectureTest {

    private static final String RESOURCE_PKG = "${RESOURCE_PKG}";     // ex.: "..resource.."
    private static final String SERVICE_PKG = "${SERVICE_PKG}";       // ex.: "..service.."
    private static final String REPOSITORY_PKG = "${REPOSITORY_PKG}"; // ex.: "..repository.."
    private static final String ENTITY_ANNOTATION = "${EE_NS}.persistence.Entity";
    private static final String ENTITY_MANAGER = "${EE_NS}.persistence.EntityManager";
    private static final String PATH_ANNOTATION = "${EE_NS}.ws.rs.Path";

    // ARC-LAY-001 — Resource não acessa Repository
    @ArchTest
    static final ArchRule resources_do_not_depend_on_repositories =
            noClasses().that().resideInAPackage(RESOURCE_PKG)
                    .should().dependOnClassesThat().resideInAPackage(REPOSITORY_PKG)
                    .because("ARC-LAY-001: Resource delega ao Service");

    // ARC-LAY-002 — Resource não acessa EntityManager
    @ArchTest
    static final ArchRule resources_do_not_use_entity_manager =
            noClasses().that().resideInAPackage(RESOURCE_PKG)
                    .should().dependOnClassesThat().haveFullyQualifiedName(ENTITY_MANAGER)
                    .because("ARC-LAY-002: persistência pertence ao Repository");

    // ARC-LAY-009 — Dependências apenas para baixo
    @ArchTest
    static final ArchRule services_do_not_depend_on_resources =
            noClasses().that().resideInAPackage(SERVICE_PKG)
                    .should().dependOnClassesThat().resideInAPackage(RESOURCE_PKG)
                    .because("ARC-LAY-009: camadas inferiores não dependem das superiores");

    @ArchTest
    static final ArchRule repositories_do_not_depend_on_services_or_resources =
            noClasses().that().resideInAPackage(REPOSITORY_PKG)
                    .should().dependOnClassesThat().resideInAnyPackage(SERVICE_PKG, RESOURCE_PKG)
                    .because("ARC-LAY-009: camadas inferiores não dependem das superiores");

    // UNI-QUA-003 — Sem ciclos entre pacotes de primeiro nível abaixo do pacote base
    @ArchTest
    static final ArchRule no_package_cycles =
            slices().matching("${BASE_PACKAGE}.(*)..").should().beFreeOfCycles();

    // BCK-DTO-001 — Métodos de Resource não recebem nem retornam @Entity
    // (inclui tipos genéricos como List<Entity>, Uni<Entity>, Optional<Entity>)
    @ArchTest
    static final ArchRule resources_do_not_expose_entities =
            ArchRuleDefinition.methods()
                    .that().areDeclaredInClassesThat().areAnnotatedWith(PATH_ANNOTATION)
                    .and().arePublic()
                    .should(notExposeEntities())
                    .because("BCK-DTO-001: contratos HTTP usam Request/Response DTOs");

    private static ArchCondition<JavaMethod> notExposeEntities() {
        return new ArchCondition<>("not receive or return @Entity types") {
            @Override
            public void check(JavaMethod method, ConditionEvents events) {
                checkTypes(method, method.getReturnType().getAllInvolvedRawTypes(), "retorna", events);
                method.getParameterTypes().forEach(type ->
                        checkTypes(method, type.getAllInvolvedRawTypes(), "recebe", events));
            }

            private void checkTypes(JavaMethod method, java.util.Set<JavaClass> types, String verb,
                                    ConditionEvents events) {
                for (JavaClass type : types) {
                    if (type.isAnnotatedWith(ENTITY_ANNOTATION)) {
                        events.add(SimpleConditionEvent.violated(method,
                                method.getFullName() + " " + verb + " a entidade " + type.getName()));
                    }
                }
            }
        };
    }
}
